package project1;
import java.sql.*;
import java.util.*;
import java.io.*;

class Customer implements Serializable{
	private String name;
	private String product;
	Customer(String name,String product){
		this.name=name;
		this.product=product;
	}
	String getname() {
		return name;
	}
	String getpro() {
		return product;
	}
}
public class Project1 {

