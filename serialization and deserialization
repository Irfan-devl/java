			o.writeObject(c);
			o.flush();
			System.out.println("hj");
			//deserialization
			Customer c1=null;
			FileInputStream inf=new FileInputStream(path);
			ObjectInputStream io=new ObjectInputStream(inf);
			c1=(Customer)io.readObject();
			System.out.print(c1.getname()+" "+c1.getpro());
		} catch (Exception e) {
